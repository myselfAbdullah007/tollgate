# Local demo credentials are intentionally public; do not expose demo mode publicly.
TOLLGATE_DEMO=true
TOLLGATE_ADMIN_EMAIL=admin@tollgate.local
TOLLGATE_ADMIN_PASSWORD=tollgate-demo-2026
# Generate with `make key`; required when TOLLGATE_DEMO=false.
TOLLGATE_MASTER_KEY=
TOLLGATE_DATABASE_URL=sqlite+aiosqlite:///./tollgate.db
TOLLGATE_REDIS_URL=
TOLLGATE_ENABLE_MOCK_PROVIDER=true
TOLLGATE_ALLOWED_ORIGIN=http://localhost:3187
TOLLGATE_COOKIE_SECURE=false
TOLLGATE_PORT=8187
TOLLGATE_MAX_CONCURRENT_REQUESTS=100
# Dashboard proxy, set at build time for a production dashboard.
TOLLGATE_API_URL=http://127.0.0.1:8187
# Optional: OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY
