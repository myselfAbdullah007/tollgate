# Publisher namespace: myselfabii (provided by the owner).
# Intended release references; publication has not yet been verified.
TOLLGATE_IMAGE=myselfabii/tollgate:latest
TOLLGATE_DASHBOARD_IMAGE=myselfabii/tollgate-dashboard:latest

# Hosts must be reachable FROM containers; localhost means the container itself.
# Use a dedicated Tollgate database and Redis instance (not another app's data).
# URL-encode reserved characters in connection-string passwords.
TOLLGATE_DATABASE_URL=postgresql+asyncpg://tollgate:REPLACE_ME@postgres.example.internal:5432/tollgate
TOLLGATE_REDIS_URL=redis://:REPLACE_ME@redis.example.internal:6379/0

# Fill these before starting. Do not share or commit the populated .env file.
TOLLGATE_ADMIN_EMAIL=owner@example.com
TOLLGATE_ADMIN_PASSWORD=
TOLLGATE_MASTER_KEY=

TOLLGATE_BIND_ADDRESS=127.0.0.1
TOLLGATE_PORT=8187
TOLLGATE_DASHBOARD_PORT=3187
TOLLGATE_ALLOWED_ORIGIN=http://localhost:3187
# Set true when serving through HTTPS.
TOLLGATE_COOKIE_SECURE=false
TOLLGATE_MAX_CONCURRENT_REQUESTS=100
# Initial aliases use mock targets. Enable for a no-paid-call exploration, or
# configure provider credentials AND replace routing targets before live use.
TOLLGATE_ENABLE_MOCK_PROVIDER=false

# Optional global fallbacks; credentials can instead be configured in the UI.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
